{
    "lora_config": {
        "r": 16,
        "lora_alpha": 32,
        "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj"],
        "lora_dropout": 0.1,
        "bias": "none",
        "task_type": "CAUSAL_LM"
    },
    "training_args": {
        "num_train_epochs": 4,
        "per_device_train_batch_size": 16,
        "gradient_accumulation_steps": 2,
        "learning_rate": 2e-5,
        "lr_scheduler_type": "cosine",
        "warmup_steps": 100,
        "save_strategy": "epoch",
        "logging_strategy": "epoch",
        "optim": "adamw_torch",
        "weight_decay": 0.01,
        "push_to_hub": false,
        "bf16": true
    }
}
