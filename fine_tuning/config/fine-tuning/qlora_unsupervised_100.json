{
    "lora_config": {
        "r": 8,
        "lora_alpha": 16,
        "target_modules": ["q_proj", "v_proj"],
        "lora_dropout": 0.1,
        "bias": "none",
        "task_type": "CAUSAL_LM"
    },
    "quantization_config": {
        "compute_dtype": "bfloat16",
        "bnb_4bit_use_double_quant": true
    },
    "training_args": {
        "num_train_epochs": 2,
        "per_device_train_batch_size": 2,
        "gradient_accumulation_steps": 8,
        "learning_rate": 0.0001,
        "logging_steps": 5,
        "save_strategy": "steps",
        "save_steps": 50,
        "weight_decay": 0.01,
        "push_to_hub": false
    }
}
