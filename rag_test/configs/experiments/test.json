{
    "out": "results/Exp1",
    "include_non_rag": true,
    "eval_data": {
        "path": "eval/scenarios.csv",
        "question_column": "question",
        "ground_truth_columns": [
            "answer_short",
            "answer_ideal",
            "answer_short_agg",
            "answer_ideal_agg"
        ]
    },
    "data": "raw/combined.csv",
    "RAG_config": {
        "embedding_model": "sentence-transformers/all-MiniLM-L6-v2",
        "top_k": 3,
        "prompt_template_path": "configs/templates/prompt/p1.yaml",
        "retrieved_item_template_path": "configs/templates/retrieved_items/c1.yaml"
    },
    "chatbots": [
        {
            "id": "meta-llama/Llama-3.2-1B-Instruct",
            "backend": "VLLMChatbot",
            "batch_size": 2,
            "config": {
                "model_path": "meta-llama/Llama-3.2-1B-Instruct",
                "temperature": 0.5,
                "max_tokens": 128,
                "top_p": 1.0,
                "llm_kwargs": {
                    "dtype": "auto",
                    "enforce_eager": true,
                    "gpu_memory_utilization": 0.8,
                    "hf_token": true,
                    "max_model_len": 4096,
                    "tensor_parallel_size": 1
                }
            }
        }
    ]
}