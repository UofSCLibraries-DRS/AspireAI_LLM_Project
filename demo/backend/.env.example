# Require bedrock:InvokeModel on imported model ARNs
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# OpenAI
OPENAI_API_KEY=

# PostgreSQL keyword/BM25 RAG (defaults shown)
RAG_DATABASE_URL=dbname=lighthouse_rag_pages
# EC2 PostgreSQL 17 runs on port 5433. Use this value on EC2:
# RAG_DATABASE_URL=dbname=lighthouse_rag_pages port=5433 user=jaaydin
RAG_TOP_K=3
RAG_MAX_CONTEXT_CHARS=12000
RAG_SEARCH_COLUMN=search_text
RAG_INDEX_NAME=documents_search_text_bm25
RAG_KEYWORD_COUNT=8
RAG_KEYWORD_MAX_NEW_TOKENS=64

# SafeGenChat is a separate local FastAPI service. Its endpoint is configured
# in configs/chatbots/sgc.yaml; launch it on this non-conflicting port:
# SGC_PORT=8001 uv run python main.py
